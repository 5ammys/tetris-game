<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Tetris2" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Tetris2" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="../../SDL_dev_lib/SDL2-2.32.4/x86_64-w64-mingw32/include" />
					<Add directory="../../SDL_dev_lib/SDL2_image-2.8.12/x86_64-w64-mingw32/include" />
					<Add directory="../../SDL_dev_lib/SDL2_ttf-2.24.0/x86_64-w64-mingw32/include" />
				</Compiler>
				<Linker>
					<Add option="-lmingw32 -lSDL2main -lSDL2 -lSDL2_image -lSDL2_ttf" />
					<Add directory="../../SDL_dev_lib/SDL2-2.32.4/x86_64-w64-mingw32/lib" />
					<Add directory="../../SDL_dev_lib/SDL2_image-2.8.12/x86_64-w64-mingw32/lib" />
					<Add directory="../../SDL_dev_lib/SDL2_ttf-2.24.0/x86_64-w64-mingw32/lib" />
				</Linker>
				<ExtraCommands>
					<Add after='cmd /c xcopy /Y /D &quot;$(PROJECT_DIR)SDL2\bin\*.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot;' />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Tetris2" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="../../SDL_dev_lib/SDL2-2.32.4/x86_64-w64-mingw32/include" />
					<Add directory="../../SDL_dev_lib/SDL2_image-2.8.12/x86_64-w64-mingw32/include" />
					<Add directory="../../SDL_dev_lib/SDL2_ttf-2.24.0/x86_64-w64-mingw32/include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add directory="../../SDL_dev_lib/SDL2-2.32.4/x86_64-w64-mingw32/lib" />
					<Add directory="../../SDL_dev_lib/SDL2_image-2.8.12/x86_64-w64-mingw32/lib" />
					<Add directory="../../SDL_dev_lib/SDL2_ttf-2.24.0/x86_64-w64-mingw32/lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="SDL2/include" />
		</Compiler>
		<Linker>
			<Add option="-lmingw32 -lSDL2main -lSDL2 -lSDL2_image -lSDL2_ttf" />
			<Add directory="SDL2/lib" />
		</Linker>
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="structures/Board.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="structures/Board.h" />
		<Unit filename="structures/Game.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="structures/Game.h" />
		<Unit filename="structures/Piece.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="structures/Piece.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
